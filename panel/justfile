# Preact frontend. Locked dependencies and committed embedded output keep Go
# builds usable offline; every build checks/rebuilds from source through here.
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

install:
    npm ci --no-audit --no-fund

build: install
    node build.mjs

test: install
    node --test test/*.test.js

lint: install
    npx --no-install prettier --check src build.mjs measure.mjs preview-checks.js test

fmt: install
    npx --no-install prettier --write src build.mjs measure.mjs preview-checks.js test

ci: lint verify test

# CI checks committed assets before any Go recipe can regenerate them.
verify: install
    node build.mjs --check

clean:
    rm -rf node_modules

# Refresh the lock only when intentionally changing dependency versions.
lock:
    npm install --package-lock-only --no-audit --no-fund

# Compare built embedded sizes with a local git baseline; no network or VM.
measure baseline='origin/main':
    node measure.mjs '{{baseline}}'
