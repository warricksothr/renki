<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that does not touch Unity or the game, so it can be tested
       with `dotnet test` on any machine. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>Renki</RootNamespace>
    <AssemblyName>Renki.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- The game ships Newtonsoft.Json 13.0.2, so the plugin is deployed
         without it; this reference is for compiling and testing. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>
</Project>
